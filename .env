# =============================================================================
# EmilianoBot — Momentum Strategy
# Copy this file, fill in secrets, and never commit it to git.
# =============================================================================

# ── Required: wallet & chain ─────────────────────────────────────────────────
# Signer private key (64 hex chars, with or without 0x prefix)
PRIVATE_KEY="0x288995e488c12fcd14e01e02d4463c6ae0e52009e839fc6a1b6b0c0d9c9a2812"

# Polymarket funder / deposit wallet address (holds USDC balance for trades)
FUNDER_ADDRESS="0x7e18acfc93289eff8f2ea95980e4fa53d2cdd852"

# Polygon JSON-RPC endpoint (Alchemy, Infura, public node, etc.)
POLYGON_RPC="https://polygon-mainnet.g.alchemy.com/v2/ikTg_Tit1gLpAVJ6B8Z9d"

# Only needed when FUNDER_ADDRESS != signer and funder must approve tokens on-chain
# FUNDER_PRIVATE_KEY=0xYOUR_FUNDER_PRIVATE_KEY_HERE

# Wallet mode: auto (default) | legacy
# POLY_WALLET_MODE=auto

# Override CLOB signature type: 0=EOA, 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE, 3=POLY_1271
# POLY_SIGNATURE_TYPE=3

# ── Required for live Redis persistence (Upstash REST) ───────────────────────
UPSTASH_REDIS_REST_URL="https://real-squid-150562.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAkwiAAIgcDE2YzRmYjVmNTU5YTM0OWNjYTcxNTcwM2QzMzE3Nzc0Nw"

# ── Trading mode ─────────────────────────────────────────────────────────────
# true = simulate orders (no on-chain submission); false = live trading
DRY_RUN_DEFAULT=false

# Alias accepted by config.py (either works)
# DRY_MODE=true

# Path to worker/sizing config (default: trading_config.json in project root)
# TRADING_CONFIG_PATH=trading_config.json

# ── Momentum strategy overrides (optional — defaults in trading_config.json) ─
# Buy when side bid >= this fraction (0.90 = 90c)
# MOMENTUM_ENTRY_THRESHOLD=0.90

# Exit when price falls this fraction below entry (0.35 = 35% loss, stop at 65% of entry)
# STOP_LOSS_PCT=0.35

# ── Order sizing overrides (set ALL THREE together, or omit all) ───────────────
# ORDER_SIZE_MIN=5.1
# ORDER_SIZE_MAX=5.1
# MAX_SHARES=5.1
# MAX_ORDER_SIZE=5.1

# ── Asset cooldown circuit breaker ───────────────────────────────────────────
# Pause new entries after this much realized loss per asset+window
ASSET_MAX_CUMULATIVE_LOSS=3.00
ASSET_COOLDOWN_MINUTES=30

# ── Market windows ───────────────────────────────────────────────────────────
# 5m or 15m crypto up/down markets
MARKET_INTERVAL=5m

# Seconds before expiry when WS listener activates / entry window ends
# Defaults to full market duration (300 for 5m, 900 for 15m) if unset
# LISTENER_ACTIVATE_SECONDS=300
# ENTRY_SECONDS_LEFT=300

# ── Trading schedule (weekday entry gate) ────────────────────────────────────
# IANA timezone for weekday checks (default UTC)
TRADING_TIMEZONE=UTC

# Comma-separated weekdays: 0=Mon … 6=Sun
TRADING_DAYS=0,1,2,3,4

# Allow entries on Sat/Sun when true
WEEKEND_TRADING=false

# ── Redis / dashboard (main.py web server) ───────────────────────────────────
PORT=7000

# Set automatically on Render; optional locally
# RENDER_EXTERNAL_URL=http://localhost:7000

# ── Optional: Telegram alerts ────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Advanced / tuning (defaults usually fine) ────────────────────────────────
# Outcome detection threshold at market expiry
# FINAL_PRICE=0.70

# Minimum fill size delta for partial-fill logic
# MIN_FILL_DELTA=0.05

# Portfolio chart dedup / heartbeat (0 = heartbeat off)
# PORTFOLIO_FLAT_EPSILON=0.005
# PORTFOLIO_HEARTBEAT_SEC=0

# ── Binance depth signal (momentum sniping — not wired into entry yet) ───────
# BINANCE_PRIME_THRESHOLD=0.20
# BINANCE_STALE_CUTOFF_SECS=5.0
# BINANCE_DEPTH_LIMIT=20
